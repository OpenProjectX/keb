# syntax=docker/dockerfile:1.7

ARG KEB_BASE_IMAGE=ghcr.io/openprojectx/keb-base:latest
FROM ${KEB_BASE_IMAGE}

ARG KEB_VERSION

LABEL org.opencontainers.image.title="Keb offline example" \
      org.opencontainers.image.description="Keb example source and report runtime layered on the reusable Keb base image" \
      org.opencontainers.image.source="https://github.com/OpenProjectX/keb" \
      org.opencontainers.image.version="${KEB_VERSION}"

ENV KEB_VERSION=${KEB_VERSION}

USER root
COPY --chown=pwuser:pwuser . /workspace
USER pwuser
WORKDIR /workspace

# Only project-specific JavaScript and report assets are added here. All JVM
# plugins, Keb modules, and runtime dependencies resolve from /m2/repository.
RUN bun install --cwd example/ui --frozen-lockfile

RUN gradle -p example --offline --no-daemon --no-configuration-cache \
      -PkebVersion="${KEB_VERSION}" \
      -PkebDependencyBundleVersion="${KEB_DEPENDENCY_BUNDLE_VERSION}" \
      -PkebBundleRepository=/m2/repository \
      -PkebBundleOfflineOnly \
      :ui:bunBuild \
      :testing:testClasses \
      -x :ui:bunInstall

RUN gradle -p example --offline --no-daemon --no-configuration-cache \
      -PkebVersion="${KEB_VERSION}" \
      -PkebDependencyBundleVersion="${KEB_DEPENDENCY_BUNDLE_VERSION}" \
      -PkebBundleRepository=/m2/repository \
      -PkebBundleOfflineOnly \
      :testing:downloadAllure

# BuildKit denies network access for this smoke test. A successful image build
# proves compilation, UI build, browser tests, and report generation use only
# the base image and project-specific files installed above.
RUN --network=none ./docker/run-offline-example.sh

CMD ["./docker/run-offline-example.sh"]
