{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"]
    },
    "playwright": {
      "type": "object",
      "required": ["version", "host", "port", "path", "maxClients", "artifactsDirectory"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "maxClients": {
          "type": "integer",
          "minimum": 1
        },
        "artifactsDirectory": {
          "type": "string",
          "minLength": 1
        },
        "unsafeLaunchOptions": {
          "type": "boolean"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "required": ["enabled", "parentRefs", "hostnames"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sharedMemory": {
      "type": "object",
      "required": ["enabled", "sizeLimit"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": ["replicaCount", "image", "playwright", "httpRoute", "sharedMemory"]
}
